# ============================================================
# ICT Trading Bot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server
PORT=5000
NODE_ENV=production
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Capital.com API credentials
# Get these from https://capital.com → Settings → API Access
CAPITAL_API_KEY=your-capital-com-api-key
CAPITAL_IDENTIFIER=your-email@example.com
CAPITAL_PASSWORD=your-capital-com-password

# API base URL — use demo for testing, live for real money
# Demo:  https://demo-api-capital.backend.gb.capital.com
# Live:  https://api-capital.backend.gb.capital.com
CAPITAL_API_URL=https://demo-api-capital.backend.gb.capital.com

# ============================================================
# Trade sizing and fixed exits (defaults are already set in code)
# ============================================================
# Margin per trade: 17,500 USD at 20x leverage = 350,000 USD notional
TRADE_LEVERAGE=20
TRADE_NOTIONAL_USD=350000

# Fixed USD exits, expressed as a percentage of the 17,500 USD margin
# Take profit: 31.6% of 17,500 = 5,530 USD
# Stop loss:   26.6% of 17,500 = 4,655 USD
TRADE_TAKE_PROFIT_USD=5530
TRADE_STOP_LOSS_USD=4655

# Market scanning is locked to BTCUSD only (no env override).
